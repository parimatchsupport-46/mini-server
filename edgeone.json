{
  "name": "edgeone-storage-server",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "nodeVersion": "20.18.0",
  "redirects": [
    {
      "source": "/admin",
      "destination": "/index.html",
      "statusCode": 302
    },
    {
      "source": "/projects",
      "destination": "/index.html",
      "statusCode": 302
    },
    {
      "source": "/storage",
      "destination": "/index.html",
      "statusCode": 302
    },
    {
      "source": "/settings",
      "destination": "/index.html",
      "statusCode": 302
    }
  ],
  "headers": [
    {
      "source": "/api/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
